# =============================================================================
# .gitignore for lung-nodule-segmentation-unet
# =============================================================================

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.pyc
*.pyo
*.pyd
.Python
pip-wheel-metadata/
.eggs/
MANIFEST

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/
.env/
lungnet/

# ─── Jupyter Notebooks ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Dataset & Large Files ────────────────────────────────────────────────────
# Never commit patient CT data — HIPAA / data use agreement
data/raw/
data/processed/
*.mhd
*.raw
*.dcm
*.nii
*.nii.gz
*.mha

# ─── Model Checkpoints (track with DVC or Git LFS instead) ───────────────────
outputs/checkpoints/*.pth
outputs/checkpoints/*.pt
outputs/checkpoints/*.ckpt
# Keep the directory itself
!outputs/checkpoints/.gitkeep

# ─── Predictions & Outputs ────────────────────────────────────────────────────
outputs/predictions/*.npy
outputs/predictions/*.png
outputs/predictions/*.jpg
outputs/visualizations/
outputs/attention/
!outputs/predictions/.gitkeep

# ─── Experiment Tracking ──────────────────────────────────────────────────────
wandb/
mlruns/
.mlflow/
lightning_logs/
runs/
logs/
*.log

# ─── IDE & OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.bak
*.tmp

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json

# ─── Secrets & Keys ───────────────────────────────────────────────────────────
.env
*.key
secrets.yaml
*_secret*
*_private*
